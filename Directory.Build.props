<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Version>1.0.6</Version>
    <LangVersion>Latest</LangVersion>
    <Nullable>enable</Nullable>
    <RepositoryUrl>https://github.com/RushuiGuan/exceptions</RepositoryUrl>
    <PackageProjectUrl>https://rushuiguan.github.io/exceptions/</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Authors>Rushui Guan</Authors>
    <PackageTags>exceptions;semantic-exceptions;vocabulary;validation;not-found;conflict;forbidden;authentication;precondition</PackageTags>
    <PackageReleaseNotes>See https://rushuiguan.github.io/exceptions/release-notes</PackageReleaseNotes>
    <!-- SourceLink Configuration -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>